# ── Virtual environment ────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python cache ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Large datasets (> 100 MB — GitHub hard limit) ─────────────────────────────
# Ignore every raw dataset by default and re-admit the small ones explicitly.
# A blanket rule is safer than naming offenders: criteo-uplift-v2.1.csv (3 GB) was
# committed once and had to be stripped out of history before the repo could push.
data/raw/*
!data/raw/.gitkeep
!data/raw/hillstrom.csv

# hillstrom.csv (3.8 MB) is committed — small enough and needed for reproducibility
# outputs/ parquets and PNGs are committed — all < 1 MB, make dashboard work on clone

# ── Deployment build artifacts ────────────────────────────────────────────────
# Regenerated by phase 4 + export_model.py; no reason to version model weights.
deployment/model_artifacts/*.json
deployment/model_artifacts/*.ubj
deployment/model_artifacts/*.joblib
deployment/model_artifacts/*.pkl
deployment/triton_model_repo/**/*.json
deployment/triton_model_repo/**/[0-9]*/
deployment/model.tar.gz
!deployment/model_artifacts/.gitkeep

# ── OS noise ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key

# ── Build / dist ──────────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
.eggs/

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Misc temp files ───────────────────────────────────────────────────────────
*.tmp
*.log
